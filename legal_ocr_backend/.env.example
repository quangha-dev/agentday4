APP_NAME=Legal OCR API
CONTRACT_VERSION=ver2
MOCK_FIXTURE_PATH=./fixtures/mock_legal_document_ver2.json
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/legal_ocr.db
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=legal_provisions_ver2
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ENABLE_TRANSFORMER_EMBEDDING=true
UPLOAD_DIR=./data/uploads
PAGE_IMAGE_DIR=./data/page_images
EXPORT_DIR=./data/exports
TESSERACT_CMD=
TESSDATA_DIR=
OCR_LANGUAGES=vie+eng
OCR_DPI_SCALE=2.5
MAX_UPLOAD_MB=100
RAG_MIN_SCORE=0.24
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
LLM_CLEANUP_PROVIDER=openrouter
LLM_CLEANUP_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENAI_API_KEY=
