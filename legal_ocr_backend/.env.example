APP_NAME=Legal OCR API
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/legal_ocr.db
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=legal_provisions
EMBEDDING_MODEL=BAAI/bge-m3
ENABLE_TRANSFORMER_EMBEDDING=false
UPLOAD_DIR=./data/uploads
PAGE_IMAGE_DIR=./data/page_images
EXPORT_DIR=./data/exports
TESSERACT_CMD=
OCR_LANGUAGES=vie+eng
MAX_UPLOAD_MB=100
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
LLM_CLEANUP_PROVIDER=openrouter
LLM_CLEANUP_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENAI_API_KEY=
