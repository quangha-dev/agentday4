# Day 04 Lab v2 — Research Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Model provider (choose ONE; Groq is the active ver2 default) ---
OPENROUTER_API_KEY=
# OPENROUTER_API_KEYS=key_2,key_3
# OPENROUTER_API_KEY_1=
# OPENROUTER_API_KEY_2=
GROQ_API_KEY=
# Optional quota failover pool. Use either a comma-separated list or numbered keys.
# GROQ_API_KEYS=gsk_key_2,gsk_key_3
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Research / read tools ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
ARXIV_USER_AGENT=AI20k-Day04-Research-Agent/1.0 (educational lab)

# --- Integrated LexFlow services ---
AGENT_PROVIDER=groq
AGENT_MODEL=openai/gpt-oss-120b
AGENT_ARTIFACT_VERSION=ver2
AGENT_MAX_TOOL_ROUNDS=6
AGENT_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
LEGAL_OCR_API_URL=http://localhost:8000/api/v1

# --- Bonus delivery (optional, advanced track) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
